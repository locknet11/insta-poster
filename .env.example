# Server binding (use 0.0.0.0 in Docker / Dokploy)
INSTA_POSTER_HOST=0.0.0.0
INSTA_POSTER_PORT=8000

# Persistent data directory (SQLite database, image pool, thumbnails, prepared renders)
# INSTA_POSTER_DATA_DIR=/app/data

# Bootstrap initial user on first run (only applied when the users table is empty)
INSTA_POSTER_INIT_USER=admin
INSTA_POSTER_INIT_PASSWORD=change-me-to-a-strong-password

# Optional API key for headless AI agents / scripts (X-API-Key header)
# INSTA_POSTER_API_KEY=replace-with-a-random-api-key

# Optional session lifetime in days (default: 30)
# INSTA_POSTER_SESSION_TTL_DAYS=30

# Optional signing secret for temporary Meta Graph API media URLs (auto-generated if omitted)
# INSTA_POSTER_SECRET_KEY=replace-with-a-random-hex-secret

# Optional cookie Secure flag override (auto-detected from HTTPS / X-Forwarded-Proto by default)
# INSTA_POSTER_COOKIE_SECURE=true

# Optional comma-separated CORS origins
# INSTA_POSTER_CORS_ORIGINS=https://insta.yourdomain.com
